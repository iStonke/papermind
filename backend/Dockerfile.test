FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt backend/requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY backend/ ./
COPY deploy/scan-button/papermind-live-preview.py /deploy/scan-button/papermind-live-preview.py
CMD ["sh", "-c", "alembic upgrade head && python -m pytest -p no:cacheprovider tests -q"]
